updates will not work, please update the plugin manually.":["\u0410\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0430 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u045a\u0430 \u043d\u0435\u045b\u0435 \u0440\u0430\u0434\u0438\u0442\u0438, \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u0458\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u0430\u043a \u0440\u0443\u0447\u043d\u043e."],"Your Version":["\u0412\u0430\u0448\u0435 \u0438\u0437\u0434\u0430\u045a\u0435"],"Warning: ":["\u0423\u043f\u043e\u0437\u043e\u0440\u0435\u045a\u0435: "],"Previous versions may not be secure or stable. Proceed with caution and always create a backup.":["\u041f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0430 \u0438\u0437\u0434\u0430\u045a\u0430 \u043c\u043e\u0436\u0434\u0430 \u043d\u0438\u0441\u0443 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0430 \u0438\u043b\u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u0430. \u041d\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u0435 \u043e\u043f\u0440\u0435\u0437\u043d\u043e \u0438 \u0443\u0432\u0435\u043a \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u043e\u043f\u0438\u0458\u0443."],"If you are facing issues after an update, you can reinstall a previous version with this tool.":["\u0410\u043a\u043e \u0438\u043c\u0430\u0442\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043f\u043e\u0441\u043b\u0435 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u045a\u0430, \u043f\u043e\u043c\u043e\u045b\u0443 \u043e\u0432\u043e\u0433 \u0430\u043b\u0430\u0442\u0430 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043d\u043e\u0432\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u043e \u0438\u0437\u0434\u0430\u045a\u0435."],"Rollback to Previous Version":["\u0412\u0440\u0430\u0442\u0438 \u043d\u0430 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u043e \u0438\u0437\u0434\u0430\u045a\u0435"],"Rank Math will not auto-update because you have rolled back to a previous version. Update to the latest version manually to make this option work again.":["Rank Math \u0441\u0435 \u043d\u0435\u045b\u0435 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u0442\u0438 \u0458\u0435\u0440 \u0441\u0442\u0435 \u0441\u0435 \u0432\u0440\u0430\u0442\u0438\u043b\u0438 \u043d\u0430 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u043e \u0438\u0437\u0434\u0430\u045a\u0435. \u0420\u0443\u0447\u043d\u043e \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u0458\u0442\u0435 \u043d\u0430 \u043d\u0430\u0458\u043d\u043e\u0432\u0438\u0458\u0435 \u0438\u0437\u0434\u0430\u045a\u0435 \u0434\u0430 \u0431\u0438 \u043e\u0432\u0430 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442 \u043f\u043e\u043d\u043e\u0432\u043e \u0440\u0430\u0434\u0438\u043b\u0430."],"Auto Update Plugin":["\u0410\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u0458 \u0434\u043e\u0434\u0430\u0442\u0430\u043a"],"Version Control":["\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u0430 \u0432\u0435\u0440\u0437\u0438\u0458\u0430"],"Save Changes":["\u0421\u0430\u0447\u0443\u0432\u0430\u0458 \u0438\u0437\u043c\u0435\u043d\u0435"],"Auto Update":["\u0410\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u043e \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u045a\u0435"],"Settings":["\u041f\u043e\u0434\u0435\u0448\u0430\u0432\u0430\u045a\u0430"],"Direct help from our qualified support team":["\u0414\u0438\u0440\u0435\u043a\u0442\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043d\u0430\u0448\u0435\u0433 \u0441\u0442\u0440\u0443\u0447\u043d\u043e\u0433 \u0442\u0438\u043c\u0430 \u0437\u0430 \u043f\u043e\u0434\u0440\u0448\u043a\u0443"],"Ticket Support":["\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u043f\u0443\u0442\u0435\u043c \u0437\u0430\u0445\u0442\u0435\u0432\u0430"],"Understand all the capabilities of Rank Math":["\u0423\u043f\u043e\u0437\u043d\u0430\u0458\u0442\u0435 \u0441\u0432\u0435 \u043c\