38\u0441\u0442\u0438\u0442\u0435 \u0441\u0430\u0434\u0440\u0436\u0430\u0458 (Table of Content) \u0434\u0430 \u043f\u043e\u0434\u0435\u043b\u0438\u0442\u0435 \u0442\u0435\u043a\u0441\u0442."],"You seem to be using a %1$s to break-down your text.":["\u0418\u0437\u0433\u043b\u0435\u0434\u0430 \u0434\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 %1$s \u0434\u0430 \u043f\u043e\u0434\u0435\u043b\u0438\u0442\u0435 \u0442\u0435\u043a\u0441\u0442."],"Add a number to your title to improve CTR.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u0431\u0440\u043e\u0458 \u0443 \u043d\u0430\u0441\u043b\u043e\u0432 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u043b\u0438 CTR."],"Headlines with numbers are 36% more likely to generate clicks, according to research by Conductor.":["\u041f\u0440\u0435\u043c\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0435 Conductor, \u043d\u0430\u0441\u043b\u043e\u0432\u0438 \u0441\u0430 \u0431\u0440\u043e\u0458\u0435\u0432\u0438\u043c\u0430 \u0438\u043c\u0430\u0458\u0443 36% \u0432\u0435\u045b\u0435 \u0448\u0430\u043d\u0441\u0435 \u0434\u0430 \u0434\u043e\u0431\u0438\u0458\u0443 \u043a\u043b\u0438\u043a\u043e\u0432\u0435."],"Your SEO title doesn't contain a number.":["\u0412\u0430\u0448 SEO \u043d\u0430\u0441\u043b\u043e\u0432 \u043d\u0435 \u0441\u0430\u0434\u0440\u0436\u0438 \u0431\u0440\u043e\u0458."],"You are using a number in your SEO title.":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0431\u0440\u043e\u0458 \u0443 \u0441\u0432\u043e\u043c SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0443."],"Power Words are tried-and-true words that copywriters use to attract more clicks.":["\u041c\u043e\u045b\u043d\u0435 \u0440\u0435\u0447\u0438 \u0441\u0443 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u0435 \u0440\u0435\u0447\u0438 \u043a\u043e\u0458\u0435 \u043f\u0438\u0441\u0446\u0438 \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u0438\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u0434\u0430 \u043f\u0440\u0438\u0432\u0443\u043a\u0443 \u0432\u0438\u0448\u0435 \u043a\u043b\u0438\u043a\u043e\u0432\u0430."],"Add %s to your title to increase CTR.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 %s \u0443 \u043d\u0430\u0441\u043b\u043e\u0432 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u043f\u043e\u0432\u0435\u045b\u0430\u043b\u0438 CTR."],"Titles with positive or negative sentiment work best for higher CTR.":["\u041d\u0430\u0441\u043b\u043e\u0432\u0438 \u0441\u0430 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u0438\u043c \u0438\u043b\u0438 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u0438\u043c \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u045a\u0435\u043c \u043d\u0430\u0458\u0431\u043e\u0459\u0435 \u0440\u0430\u0434\u0435 \u0437\u0430 \u0432\u0435\u045b\u0438 CTR."],"Headlines with a strong emotional sentiment (positive or negative) tend to receive more clicks.":["\u041d\u0430\u0441\u043b\u043e\u0432\u0438 \u0441\u0430 \u0441\u043d\u0430\u0436\u043d\u0438\u043c \u0435\u043c\u043e\u0442\u0438\u0432\u043d\u0438\u043c \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u045a\u0435\u043c (\u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u0438\u043c \u0438\u043b\u0438 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u0438\u043c) \u043e\u0431\u0438\u0447\u043d\u043e \u0434\u043e\u0431\u0438\u0458\u0430\u0458\u0443 \u0432\u0438\u0448\u0435 \u043a\u043b\u0438\u043a\u043e\u0432\u0430."],"Your title has a positive or a negative sentiment.":["\u0412\u0430\u0448 \u043d\u0430\u0441\u043b\u043e\u0432 \u0438\u043c\u0430 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u043e \u0438\u043b\u0438 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u045a\u0435."],"The SEO page title should contain the Focus Keyword preferably at the beginning.":["SEO \u043d\u0430\u0441\u043b\u043e\u0432 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u0442\u0440\u0435\u0431\u0430 \u0434\u0430 \u0441\u0430\u0434\u0440\u0436\u0438 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447, \u043f\u043e \u043c\u043e\u0433\u0443\u045b\u0441\u0442\u0432\u0443 \u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043a\u0443."],"Use the Focus Keyword near the beginning of SEO title.":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0431\u043b\u0438\u0437\u0443 \u043f\u043e\u0447\u0435\u0442\u043a\u0430 SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0430."],"Focus Keyword doesn't appear at the beginning of SEO title.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0441\u0435 \u043d\u0435 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043a\u0443 SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0430."],"Focus Keyword used at the beginning of SEO title.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0459\u0435\u043d\u0430 \u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043a\u0443 SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0430."],"We are searching in database.":["\u041f\u0440\u0435\u0442\u0440\u0430\u0436\u0443\u0458\u0435\u043c\u043e \u0431\u0430\u0437\u0443 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430."],"Set a Focus Keyword for this content.":["\u041f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0441\u0430\u0434\u0440\u0436\u0430\u0458."],"already used":["\u0432\u0435\u045b \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0459\u0435\u043d\u043e"],"You haven't used this Focus Keyword before.":["\u041e\u0432\u0443 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0440\u0430\u043d\u0438\u0458\u0435 \u043d\u0438\u0441\u0442\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u043b\u0438."],"Internal links decrease your bounce rate and improve SEO.":["\u0423\u043d\u0443\u0442\u0440\u0430\u0448\u045a\u0435 \u0432\u0435\u0437\u0435 \u0441\u043c\u0430\u045a\u0443\u0458\u0443 \u0441\u0442\u043e\u043f\u0443 \u043e\u0434\u0431\u0438\u0458\u0430\u045a\u0430 \u0438 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u0432\u0430\u0458\u0443 SEO."],"Add internal links in your content.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u0443\u043d\u0443\u0442\u0440\u0430\u0448\u045a\u0435 \u0432\u0435\u0437\u0435 \u0443 \u0441\u0432\u043e\u0458 \u0441\u0430\u0434\u0440\u0436\u0430\u0458."],"We couldn't find any internal links in your content.":["\u041d\u0438\u0441\u043c\u043e \u043f\u0440\u043e\u043d\u0430\u0448\u043b\u0438 \u043d\u0438\u0458\u0435\u0434\u043d\u0443 \u0443\u043d\u0443\u0442\u0440\u0430\u0448\u045a\u0443 \u0432\u0435\u0437\u0443 \u0443 \u0432\u0430\u0448\u0435\u043c \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443."],"You are linking to other resources on your website which is great.":["\u041f\u043e\u0432\u0435\u0437\u0443\u0458\u0435\u0442\u0435 \u0441\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u0440\u0435\u0441\u0443\u0440\u0441\u0438\u043c\u0430 \u043d\u0430 \u0441\u0432\u043e\u043c \u0432\u0435\u0431 \u0441\u0430\u0458\u0442\u0443, \u0448\u0442\u043e \u0458\u0435 \u0441\u0458\u0430\u0458\u043d\u043e."],"There is no ideal keyword density percentage, but it should not be too high. The most important thing is to keep the copy natural.":["\u041d\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0438 \u0438\u0434\u0435\u0430\u043b\u0430\u043d \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0433\u0443\u0441\u0442\u0438\u043d\u0435 \u043a\u0459\u0443\u0447\u043d\u0438\u0445 \u0440\u0435\u0447\u0438, \u0430\u043b\u0438 \u043d\u0435 \u0431\u0438 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0434\u0430 \u0431\u0443\u0434\u0435 \u043f\u0440\u0435\u0432\u0438\u0441\u043e\u043a. \u041d\u0430\u0458\u0432\u0430\u0436\u043d\u0438\u0458\u0435 \u0458\u0435 \u0434\u0430 \u0442\u0435\u043a\u0441\u0442 \u043e\u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u043d."],"Keyword Density is %1$s, the Focus Keyword and combination appears %2$s times.":["\u0413\u0443\u0441\u0442\u0438\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0438\u0445 \u0440\u0435\u0447\u0438 \u0458\u0435 %1$s, \u0444\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0438 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0458\u0430 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0443 \u0441\u0435 %2$s \u043f\u0443\u0442\u0430."],"PageRank Sculpting no longer works. Your posts should have a mix of nofollow and DoFollow links.":["PageRank Sculpting \u0432\u0438\u0448\u0435 \u043d\u0435 \u0434\u0435\u043b\u0443\u0458\u0435. \u0412\u0430\u0448\u0438 \u0447\u043b\u0430\u043d\u0446\u0438 \u0442\u0440\u0435\u0431\u0430 \u0434\u0430 \u0438\u043c\u0430\u0458\u0443 \u043c\u0435\u0448\u0430\u0432\u0438\u043d\u0443 nofollow \u0438 DoFollow \u0432\u0435\u0437\u0430."],"Add DoFollow links pointing to external resources.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 DoFollow \u0432\u0435\u0437\u0435 \u043a\u043e\u0458\u0435 \u0443\u043f\u0443\u045b\u0443\u0458\u0443 \u043d\u0430 \u0441\u043f\u043e\u0459\u043d\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u0435."],"At least one external link with DoFollow found in your content.":["\u0423 \u0432\u0430\u0448\u0435\u043c \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443 \u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0431\u0430\u0440 \u0458\u0435\u0434\u043d\u0430 \u0441\u043f\u043e\u0459\u043d\u0430 DoFollow \u0432\u0435\u0437\u0430."],"It helps visitors read more about a topic and prevents pogosticking.":["\u041f\u043e\u043c\u0430\u0436\u0435 \u043f\u043e\u0441\u0435\u0442\u0438\u043e\u0446\u0438\u043c\u0430 \u0434\u0430 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0458\u0443 \u0432\u0438\u0448\u0435 \u043e \u0442\u0435\u043c\u0438 \u0438 \u0441\u043f\u0440\u0435\u0447\u0430\u0432\u0430 \u0431\u0440\u0437\u043e \u0432\u0440\u0430\u045b\u0430\u045a\u0435 \u043d\u0430 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0435 \u043f\u0440\u0435\u0442\u0440\u0430\u0433\u0435."],"No outbound links were found. Link out to external resources.":["\u041d\u0438\u0441\u0443 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0435 \u043e\u0434\u043b\u0430\u0437\u043d\u0435 \u0432\u0435\u0437\u0435. \u041f\u043e\u0432\u0435\u0436\u0438\u0442\u0435 \u0441\u0430 \u0441\u043f\u043e\u0459\u043d\u0438\u043c \u0440\u0435\u0441\u0443\u0440\u0441\u0438\u043c\u0430."],"Link out to external resources.":["\u041f\u043e\u0432\u0435\u0436\u0438\u0442\u0435 \u0441\u0430 \u0441\u043f\u043e\u0459\u043d\u0438\u043c \u0440\u0435\u0441\u0443\u0440\u0441\u0438\u043c\u0430."],"Great! You are linking to external resources.":["\u0421\u0458\u0430\u0458\u043d\u043e! \u041f\u043e\u0432\u0435\u0437\u0443\u0458\u0435\u0442\u0435 \u0441\u0430 \u0441\u043f\u043e\u0459\u043d\u0438\u043c \u0440\u0435\u0441\u0443\u0440\u0441\u0438\u043c\u0430."],"It is recommended to add the focus keyword in the alt attribute of one or more images.":["\u041f\u0440\u0435\u043f\u043e\u0440\u0443\u0447\u0443\u0458\u0435 \u0441\u0435 \u0434\u0430 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0434\u043e\u0434\u0430\u0442\u0435 \u0443 alt \u0430\u0442\u0440\u0438\u0431\u0443\u0442 \u0458\u0435\u0434\u043d\u0435 \u0438\u043b\u0438 \u0432\u0438\u0448\u0435 \u0441\u043b\u0438\u043a\u0430."],"Add an image with your Focus Keyword as alt text.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u0441\u043b\u0438\u043a\u0443 \u0441\u0430 \u0444\u043e\u043a\u0443\u0441\u043d\u043e\u043c \u043a\u0459\u0443\u0447\u043d\u043e\u043c \u0440\u0435\u0447\u0438 \u043a\u0430\u043e alt \u0442\u0435\u043a\u0441\u0442\u043e\u043c."],"Focus Keyword found in image alt attribute(s).":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 alt \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u043c\u0430 \u0441\u043b\u0438\u043a\u0430."],"Focus Keyword not found in image alt attribute(s).":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043d\u0438\u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 alt \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u043c\u0430 \u0441\u043b\u0438\u043a\u0430."],"It is recommended to add the focus keyword as part of one or more subheadings in the content.":["\u041f\u0440\u0435\u043f\u043e\u0440\u0443\u0447\u0443\u0458\u0435 \u0441\u0435 \u0434\u0430 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0434\u043e\u0434\u0430\u0442\u0435 \u043a\u0430\u043e \u0434\u0435\u043e \u0458\u0435\u0434\u043d\u043e\u0433 \u0438\u043b\u0438 \u0432\u0438\u0448\u0435 \u043f\u043e\u0434\u043d\u0430\u0441\u043b\u043e\u0432\u0430 \u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443."],"Use Focus Keyword in subheading(s) like H2, H3, H4, etc..":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 \u043f\u043e\u0434\u043d\u0430\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 H2, H3, H4 \u0438\u0442\u0434."],"Focus Keyword not found in subheading(s) like H2, H3, H4, etc..":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043d\u0438\u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 \u043f\u043e\u0434\u043d\u0430\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 H2, H3, H4 \u0438\u0442\u0434."],"Focus Keyword found in the subheading(s).":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 \u043f\u043e\u0434\u043d\u0430\u0441\u043b\u043e\u0432\u0438\u043c\u0430."],"Permalink should be at most 75 characters long.":["\u0421\u0442\u0430\u043b\u043d\u0430 \u0432\u0435\u0437\u0430 \u0442\u0440\u0435\u0431\u0430 \u0434\u0430 \u0438\u043c\u0430 \u043d\u0430\u0458\u0432\u0438\u0448\u0435 75 \u0437\u043d\u0430\u043a\u043e\u0432\u0430."],"URL unavailable. Add a short URL.":["URL \u043d\u0438\u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0430\u043d. \u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u043a\u0440\u0430\u0442\u0430\u043a URL."],"Minimum recommended content length should be 600 words.":["\u041d\u0430\u0458\u043c\u0430\u045a\u0430 \u043f\u0440\u0435\u043f\u043e\u0440\u0443\u0447\u0435\u043d\u0430 \u0434\u0443\u0436\u0438\u043d\u0430 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0430 \u0458\u0435 600 \u0440\u0435\u0447\u0438."],"It is recommended to make the focus keyword appear in the post content too.":["\u041f\u0440\u0435\u043f\u043e\u0440\u0443\u0447\u0443\u0458\u0435 \u0441\u0435 \u0434\u0430 \u0441\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043f\u043e\u0458\u0430\u0432\u0438 \u0438 \u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443 \u0447\u043b\u0430\u043d\u043a\u0430."],"Use Focus Keyword in the content.":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443."],"Focus Keyword doesn't appear in the content.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0441\u0435 \u043d\u0435 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443."],"Focus Keyword found in the content.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0443."],"The first 10% of the content should contain the Focus Keyword preferably at the beginning.":["\u041f\u0440\u0432\u0438\u0445 10% \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0430 \u0442\u0440\u0435\u0431\u0430 \u0434\u0430 \u0441\u0430\u0434\u0440\u0436\u0438 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447, \u043f\u043e \u043c\u043e\u0433\u0443\u045b\u0441\u0442\u0432\u0443 \u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043a\u0443."],"Use Focus Keyword at the beginning of your content.":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043a\u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0430."],"Focus Keyword doesn't appear at the beginning of your content.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0441\u0435 \u043d\u0435 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043a\u0443 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0430."],"Focus Keyword appears in the first 10% of the content.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0441\u0435 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0443 \u043f\u0440\u0432\u0438\u0445 10% \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0430."],"Include the focus keyword in the slug (permalink) of this post.":["\u0423\u043a\u0459\u0443\u0447\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 \u043a\u0440\u0430\u0442\u043a\u043e \u0438\u043c\u0435 (\u0441\u0442\u0430\u043b\u043d\u0443 \u0432\u0435\u0437\u0443) \u043e\u0432\u043e\u0433 \u0447\u043b\u0430\u043d\u043a\u0430."],"Use Focus Keyword in the URL.":["\u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 URL-\u0443."],"Focus Keyword not found in the URL.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043d\u0438\u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 URL-\u0443."],"Focus Keyword used in the URL.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0459\u0435\u043d\u0430 \u0443 URL-\u0443."],"Make sure the focus keyword appears in the SEO description too.":["\u0423\u0432\u0435\u0440\u0438\u0442\u0435 \u0441\u0435 \u0434\u0430 \u0441\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0438 \u0443 SEO \u043e\u043f\u0438\u0441\u0443."],"Add Focus Keyword to your SEO Meta Description.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 SEO \u043c\u0435\u0442\u0430 \u043e\u043f\u0438\u0441."],"Focus Keyword not found in your SEO Meta Description.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043d\u0438\u0458\u0435 \u043f\u0440\u043e\u043d\u0430\u0452\u0435\u043d\u0430 \u0443 SEO \u043c\u0435\u0442\u0430 \u043e\u043f\u0438\u0441\u0443."],"Focus Keyword used inside SEO Meta Description.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0459\u0435\u043d\u0430 \u0443 SEO \u043c\u0435\u0442\u0430 \u043e\u043f\u0438\u0441\u0443."],"Make sure the focus keyword appears in the SEO post title too.":["\u0423\u0432\u0435\u0440\u0438\u0442\u0435 \u0441\u0435 \u0434\u0430 \u0441\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0438 \u0443 SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0443 \u0447\u043b\u0430\u043d\u043a\u0430."],"Add Focus Keyword to the SEO title.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 SEO \u043d\u0430\u0441\u043b\u043e\u0432."],"Focus Keyword does not appear in the SEO title.":["\u0424\u043e\u043a\u0443\u0441\u043d\u0430 \u043a\u0459\u0443\u0447\u043d\u0430 \u0440\u0435\u0447 \u0441\u0435 \u043d\u0435 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0443 SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0443."],"Hurray! You're using Focus Keyword in the SEO Title.":["\u0423\u0440\u0430! \u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u0444\u043e\u043a\u0443\u0441\u043d\u0443 \u043a\u0459\u0443\u0447\u043d\u0443 \u0440\u0435\u0447 \u0443 SEO \u043d\u0430\u0441\u043b\u043e\u0432\u0443."],"Short paragraphs are easier to read and more pleasing to the eye. Long paragraphs scare the visitor, and they might result to SERPs looking for better readable content.":["\u041a\u0440\u0430\u0442\u043a\u0438 \u043f\u0430\u0441\u0443\u0441\u0438 \u0441\u0435 \u043b\u0430\u043a\u0448\u0435 \u0447\u0438\u0442\u0430\u0458\u0443 \u0438 \u043f\u0440\u0438\u0458\u0430\u0442\u043d\u0438\u0458\u0438 \u0441\u0443 \u043e\u043a\u0443. \u0414\u0443\u0433\u0438 \u043f\u0430\u0441\u0443\u0441\u0438 \u043f\u043b\u0430\u0448\u0435 \u043f\u043e\u0441\u0435\u0442\u0438\u043e\u0446\u0435, \u043a\u043e\u0458\u0438 \u0441\u0435 \u043c\u043e\u0433\u0443 \u0432\u0440\u0430\u0442\u0438\u0442\u0438 \u043d\u0430 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0435 \u043f\u0440\u0435\u0442\u0440\u0430\u0433\u0435 \u0443 \u043f\u043e\u0442\u0440\u0430\u0437\u0438 \u0437\u0430 \u0447\u0438\u0442\u0459\u0438\u0432\u0438\u0458\u0438\u043c \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0435\u043c."],"Add short and concise paragraphs for better readability and UX.":["\u0414\u043e\u0434\u0430\u0458\u0442\u0435 \u043a\u0440\u0430\u0442\u043a\u0435 \u0438 \u0441\u0430\u0436\u0435\u0442\u0435 \u043f\u0430\u0441\u0443\u0441\u0435 \u0440\u0430\u0434\u0438 \u0431\u043e\u0459\u0435 \u0447\u0438\u0442\u0459\u0438\u0432\u043e\u0441\u0442\u0438 \u0438 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u0447\u043a\u043e\u0433 \u0438\u0441\u043a\u0443\u0441\u0442\u0432\u0430."]}},"comment":{"reference":"assets\/admin\/js\/analyzer.js"}}