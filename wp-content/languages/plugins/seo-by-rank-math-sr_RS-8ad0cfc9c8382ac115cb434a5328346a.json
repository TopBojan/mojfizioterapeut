e trial and see exactly where AI mentions your brand. Your %d-day trial gives you full access to track, analyze, and grow your presence, before your competitors do.":["\u0417\u0430\u043f\u043e\u0447\u043d\u0438\u0442\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0443 \u043f\u0440\u043e\u0431\u0443 \u0438 \u0432\u0438\u0434\u0438\u0442\u0435 \u0442\u0430\u0447\u043d\u043e \u0433\u0434\u0435 \u0432\u0430\u0441 \u0412\u0418 \u043f\u043e\u043c\u0438\u045a\u0435. \u0412\u0430\u0448\u0430 \u043f\u0440\u043e\u0431\u0430 \u043e\u0434 %d \u0434\u0430\u043d\u0430 \u043f\u0440\u0443\u0436\u0430 \u0432\u0430\u043c \u043f\u0443\u043d \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u043f\u0440\u0430\u045b\u0435\u045a\u0443, \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0443 \u043f\u0440\u0438\u0441\u0443\u0441\u0442\u0432\u0430, \u043f\u0440\u0435 \u0432\u0430\u0448\u0438\u0445 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0430\u0442\u0430."],"Activate Your AI Visibility Trial":["\u0423\u043a\u0459\u0443\u0447\u0438\u0442\u0435 \u043f\u0440\u043e\u0431\u0443 \u0412\u0418 \u0432\u0438\u0434\u0459\u0438\u0432\u043e\u0441\u0442\u0438"],"Connecting to AI search models\u2026":["\u041f\u043e\u0432\u0435\u0437\u0438\u0432\u0430\u045a\u0435 \u0441\u0430 \u0412\u0418 \u043c\u043e\u0434\u0435\u043b\u0438\u043c\u0430 \u043f\u0440\u0435\u0442\u0440\u0430\u0433\u0435\u2026"],"Provisioning AI tracking workspace\u2026":["\u041f\u0440\u0438\u043f\u0440\u0435\u043c\u0430 \u0440\u0430\u0434\u043d\u043e\u0433 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430 \u0437\u0430 \u0412\u0418 \u043f\u0440\u0430\u045b\u0435\u045a\u0435\u2026"],"Authenticating credentials\u2026":["\u041f\u043e\u0442\u0432\u0440\u0452\u0438\u0432\u0430\u045a\u0435 \u0430\u043a\u0440\u0435\u0434\u0438\u0442\u0438\u0432\u0430\u2026"],"Something went wrong while activating your trial. Please try again.":["\u041d\u0435\u0448\u0442\u043e \u043d\u0438\u0458\u0435 \u0443 \u0440\u0435\u0434\u0443 \u043f\u0440\u0438 \u0443\u043a\u0459\u0443\u0447\u0438\u0432\u0430\u045a\u0443 \u043f\u0440\u043e\u0431\u0435. \u041f\u043e\u043a\u0443\u0448\u0430\u0458\u0442\u0435 \u043f\u043e\u043d\u043e\u0432\u043e."],"30-Day Money-Back Guarantee":["\u0413\u0430\u0440\u0430\u043d\u0446\u0438\u0458\u0430 \u043f\u043e\u0432\u0440\u0430\u0442\u0430 \u043d\u043e\u0432\u0446\u0430 \u043e\u0434 30 \u0434\u0430\u043d\u0430"],"Start 15-Day Free Trial":["\u0417\u0430\u043f\u043e\u0447\u043d\u0438 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0443 \u043f\u0440\u043e\u0431\u0443 \u043e\u0434 15 \u0434\u0430\u043d\u0430"],"Upgrade to unlock AI Visibility module and see where your brand appears across ChatGPT, and other AI platforms, and take action before you fall further behind.":["\u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u043e\u0442\u043a\u0459\u0443\u0447\u0430\u043b\u0438 \u043c\u043e\u0434\u0443\u043b \u0412\u0418 \u0432\u0438\u0434\u0459\u0438\u0432\u043e\u0441\u0442\u0438 \u0438 \u0432\u0438\u0434\u0435\u043b\u0438 \u0433\u0434\u0435 \u0441\u0435 \u0432\u0430\u0448 \u0431\u0440\u0435\u043d\u0434 \u043f\u043e\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0443 ChatGPT-\u0443 \u0438 \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u0412\u0418 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0430, \u0438 \u043f\u0440\u0435\u0434\u0443\u0437\u043c\u0438\u0442\u0435 \u043d\u0435\u0448\u0442\u043e \u043f\u0440\u0435 \u043d\u0435\u0433\u043e \u0448\u0442\u043e \u0458\u043e\u0448 \u0432\u0438\u0448\u0435 \u0437\u0430\u043e\u0441\u0442\u0430\u043d\u0435\u0442\u0435."],"Your competitors are already tracking their AI presence. You should be too.":["\u0412\u0430\u0448\u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u0438 \u0432\u0435\u045b \u043f\u0440\u0430\u0442\u0435 \u0441\u0432\u043e\u0458\u0435 \u0412\u0418 \u043f\u0440\u0438\u0441\u0443\u0441\u0442\u0432\u043e. \u0422\u0440\u0435\u0431\u0430\u043b\u043e \u0431\u0438 \u0438 \u0432\u0438."],"Upgrade to Unlock AI Visibility":["\u041d\u0430\u0434\u043e\u0433\u0440\u0430\u0434\u0438\u0442\u0435 \u0434\u0430 \u0431\u0438\u0441\u0442\u0435 \u043e\u0442\u043a\u0459\u0443\u0447\u0430\u043b\u0438 \u0412\u0418 \u0432\u0438\u0434\u0459\u0438\u0432\u043e\u0441\u0442"],"Spot opportunities to grow your AI-driven traffic":["\u0423\u043e\u0447\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u0438\u043a\u0435 \u0437\u0430 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0435 \u0441\u0430\u043e\u0431\u0440\u0430\u045b\u0430\u0458\u0430 \u043a\u043e\u0458\u0438 \u0434\u043e\u043b\u0430\u0437\u0438 \u043f\u0440\u0435\u043a\u043e \u0412\u0418"],"Benchmark your AI visibility against competitors":["\u0423\u043f\u043e\u0440\u0435\u0434\u0438\u0442\u0435 \u0441\u0432\u043e\u0458\u0443 \u0412\u0418 \u0432\u0438\u0434\u0459\u0438\u0432\u043e\u0441\u0442 \u0441\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u0438\u043c\u0430"],"See which pages AI models cite as sources":["\u041f\u043e\u0433\u043b\u0435\u0434\u0430\u0458\u0442\u0435 \u043a\u043e\u0458\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u0412\u0418 \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0430\u0432\u043e\u0434\u0435 \u043a\u0430\u043e \u0438\u0437\u0432\u043e\u0440\u0435"],"Monitor sentiment across AI search results":["\u041f\u0440\u0430\u0442\u0438\u0442\u0435 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u045a\u0435 \u0443 \u0412\u0418 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0438\u043c\u0430 \u043f\u0440\u0435\u0442\u0440\u0430\u0433\u0435"],"Track how often AI mentions your brand":["\u041f\u0440\u0430\u0442\u0438\u0442\u0435 \u043a\u043e\u043b\u0438\u043a\u043e \u0447\u0435\u0441\u0442\u043e \u0432\u0430\u0441 \u0412\u0418 \u043f\u043e\u043c\u0438\u045a\u0435"],"Adding\u2026":["\u0414\u043e\u0434\u0430\u0432\u0430\u045a\u0435\u2026"],"Website URL is required.":["URL \u0432\u0435\u0431 \u0441\u0430\u0458\u0442\u0430 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d."],"Description is required.":["\u041e\u043f\u0438\u0441 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043d."],"Please enter a valid URL (must start with https:\/\/).":["\u0423\u043d\u0435\u0441\u0438\u0442\u0435 \u0438\u0441\u043f\u0440\u0430\u0432\u0430\u043d URL (\u043c\u043e\u0440\u0430 \u043f\u043e\u0447\u0438\u045a\u0430\u0442\u0438 \u0441\u0430 https:\/\/)."],"Brand name is required.":["\u0418\u043c\u0435 \u0431\u0440\u0435\u043d\u0434\u0430 \u0458\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u043d\u043e."],"AI Platforms":["\u0412\u0418 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435"],"Frequency of analyses":["\u0423\u0447\u0435\u0441\u0442\u0430\u043b\u043e\u0441\u0442 \u0430\u043d\u0430\u043b\u0438\u0437\u0430"],"Target Country (Optional)":["\u0426\u0438\u0459\u043d\u0430 \u0434\u0440\u0436\u0430\u0432\u0430 (\u043d\u0435\u043e\u0431\u0430\u0432\u0435\u0437\u043d\u043e)"],"How would you describe your brand\/product?":["\u041a\u0430\u043a\u043e \u0431\u0438\u0441\u0442\u0435 \u043e\u043f\u0438\u0441\u0430\u043b\u0438 \u0441\u0432\u043e\u0458 \u0431\u0440\u0435\u043d\u0434\/\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434?"],"Describe what your brand\/product does, who it's for, and what makes it unique. This helps AI models identify and accurately represent you.":["\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0448\u0442\u0430 \u0432\u0430\u0448 \u0431\u0440\u0435\u043d\u0434\/\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434 \u0440\u0430\u0434\u0438, \u043a\u043e\u043c\u0435 \u0458\u0435 \u043d\u0430\u043c\u0435\u045a\u0435\u043d \u0438 \u0448\u0442\u0430 \u0433\u0430 \u0447\u0438\u043d\u0438 \u0458\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u0438\u043c. \u041e\u0432\u043e \u043f\u043e\u043c\u0430\u0436\u0435 \u0412\u0418 \u043c\u043e\u0434\u0435\u043b\u0438\u043c\u0430 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0458\u0443 \u0