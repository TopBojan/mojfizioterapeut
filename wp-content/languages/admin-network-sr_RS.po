msgstr "Веза Уреди ка посебном екрану Уреди сајт."

#: wp-admin/network/sites.php:31
msgid "Add Site takes you to the screen for adding a new site to the network. You can search for a site by Name, ID number, or IP address. Screen Options allows you to choose how many sites to display on one page."
msgstr "Додај сајт води на екран за додавање новог сајта у мрежу. Сајт можете претражити по називу, ID броју или IP адреси. Могућности екрана вам дозвољавају да изаберете колико ће сајтова бити приказано на једној страници."

#: wp-admin/network/settings.php:247
msgid "Add Users"
msgstr "Додај кориснике"

#: wp-admin/network/user-new.php:55
msgid "Cannot add user."
msgstr "Није могуће додати корисника."

#: wp-admin/network/user-new.php:22
msgid "Add User will set up a new user account on the network and send that person an email with username and password."
msgstr "Додај корисника ће направити нови кориснички налог на мрежи и послаће тој особи е-пошту са корисничким именом и лозинком."

#: wp-admin/network/menu.php:46
msgid "Updates"
msgstr "Ажурирања"

#: wp-admin/network/menu.php:116 wp-admin/network/settings.php:21
