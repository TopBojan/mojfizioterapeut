msgstr "Трајно избриши, што је трајна радња након екрана за потврду."

#: wp-admin/network/sites.php:35
msgid "Dashboard leads to the Dashboard for that site."
msgstr "Контролна табла води ка контролној табли тог сајта."

#: wp-admin/network/sites.php:34
